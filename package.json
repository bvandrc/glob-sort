{
  "name": "glob-sort",
  "version": "1.1.2",
  "description": "Glob files and sort them in a custom order — by numeric folder prefixes and your own string/regex rules. Zero dependencies. Ideal for controlling test execution order in Cypress, Playwright, or Vitest.",
  "keywords": [
    "glob",
    "sort",
    "sorting",
    "sort-order",
    "custom-sort",
    "glob-sort",
    "sorted-glob",
    "file-order",
    "test-order",
    "test-execution-order",
    "spec-order",
    "specpattern",
    "cypress",
    "playwright",
    "vitest",
    "jest",
    "e2e",
    "typescript"
  ],
  "homepage": "https://www.npmjs.com/package/glob-sort",
  "bugs": {
    "url": "https://github.com/bvandrc/glob-sort/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bvandrc/glob-sort"
  },
  "author": {
    "name": "Blake Vandercar",
    "email": "bvandercar@outlook.com"
  },
  "license": "MIT",
  "type": "module",
  "source": "src/sortedGlob.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "__c0": "====================[ Build & Development ]======================",
    "prepack": "pnpm build",
    "build": "tsdown",
    "start": "tsdown --watch",
    "__c1": "====================[ Linting & Type Checking ]==================",
    "check": "npx biome check . && pnpm ts:check",
    "format": "npx biome check . --fix",
    "ts:check": "tsc --noEmit",
    "__c2": "====================[ Unit Testing ]=======================",
    "test": "vitest",
    "test:unit": "pnpm test:coverage",
    "test:watch": "pnpm run test --watch",
    "test:coverage": "pnpm run test --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4",
    "@vitest/expect": "^4",
    "memfs": "^4",
    "tsdown": "^0.22",
    "type-fest": "^5",
    "typescript": "^7",
    "vitest": "^4"
  }
}
