// Shared by every repo that syncs bvandrc-conventions, extended by its own
// biome.json(c). Settings only a repo can know (files.includes, test-file
// overrides, framework rules) belong there, not here.
{
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:", "react"],
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"],
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"]
            ]
          }
        }
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  // Stated explicitly, defaults included, so a change to Biome's defaults
  // can't move them.
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "bracketSameLine": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  // Biome formats Markdown by default from 2.6.
  "markdown": {
    "parser": {
      // Off by default, which reads a leading `---` block as a thematic break
      // and a heading, and reformats it into one.
      "frontmatter": true
    },
    "formatter": {
      // Never hard-wrap prose: a wrapped paragraph is unwrapped, not passed.
      // This also joins consecutive lines of plain text, so line-by-line content
      // (like CLAUDE.md's @conventions imports) goes in a list or a table.
      "proseWrap": "never"
    }
  },
  // Biome formats YAML by default from 2.6. Single quotes match the
  // JavaScript style above.
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  // Raises rules from warning to error, or turns on ones `recommended` leaves
  // off. It stops short of every rule the conventions state, since repos vary:
  // noDefaultExport is absent, and useFilenamingConvention keeps its defaults,
  // which accept both a kebab-case util and a PascalCase component.
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": { "level": "error", "fix": "safe" },
        "noUnusedVariables": "error",
        "useJsonImportAttributes": "error",
        "useParseIntRadix": "off"
      },
      "nursery": {
        "noFloatingPromises": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noBarrelFile": "error",
        "noDelete": "error",
        "noNamespaceImport": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noParameterAssign": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noYodaExpression": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentObjectDefinitions": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        "useEnumInitializers": "error",
        "useFilenamingConvention": "error",
        // typescript.md: `import type` for type-only imports.
        "useImportType": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useReadonlyClassProperties": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error"
      },
      "suspicious": {
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "error",
        "noEmptyBlockStatements": "error",
        "noEvolvingTypes": "error",
        "noImportCycles": "error",
        "noShadow": "error",
        "noTsIgnore": "error",
        "noUnassignedVariables": "error",
        "noUselessEscapeInString": "error",
        "useAwait": "error"
      }
    }
  }
}
